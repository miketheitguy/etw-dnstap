Space=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontColor=#24415a;" vertex="1" parent="1"><mxGeometry x="646" y="945" width="520" height="18" as="geometry"/></mxCell><mxCell id="timers-c245" value="7  try_recv until empty; linger ≤ 200 µs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="992" width="300" height="26" as="geometry"/></mxCell><mxCell id="timers-l246" value="" style="html=1;strokeColor=#4b84b5;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#18324b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1060" as="sourcePoint"/><mxPoint x="280" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="timers-c247" value="8  deliver buffer k+1 inside the linger → no park, no new wake cost" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontColor=#24415a;" vertex="1" parent="1"><mxGeometry x="106" y="1040" width="520" height="18" as="geometry"/></mxCell><mxCell id="timers-c248" value="9  empty linger → linger off; park_timeout(2→20 ms)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="1107" width="300" height="26" as="geometry"/></mxCell><mxCell id="timers-c249" value="&lt;b&gt;Timer constants and history&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;th&gt;Timer&lt;/th&gt;&lt;th&gt;Value&lt;/th&gt;&lt;th&gt;Where&lt;/th&gt;&lt;th&gt;Since&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ETW FlushTimer&lt;/td&gt;&lt;td&gt;1 s (1–60)&lt;/td&gt;&lt;td&gt;session.rs:159; pipeline.rs:76&lt;/td&gt;&lt;td&gt;initial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Periodic flush&lt;/td&gt;&lt;td&gt;0 = off; 20–1000 ms; recommended 50&lt;/td&gt;&lt;td&gt;pipeline.rs:86, 897&lt;/td&gt;&lt;td&gt;e59425f&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Parser park (Oct 28–29)&lt;/td&gt;&lt;td&gt;fixed 2 ms; observed median ≈16 ms&lt;/td&gt;&lt;td&gt;08254d4 pipeline.rs:684; Q1K&lt;/td&gt;&lt;td&gt;initial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Parser park (now)&lt;/td&gt;&lt;td&gt;2 → 20 ms doubling, reset on data&lt;/td&gt;&lt;td&gt;pipeline.rs:1181, 1191, 1195&lt;/td&gt;&lt;td&gt;e59425f&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Linger after data&lt;/td&gt;&lt;td&gt;200 µs, adaptive&lt;/td&gt;&lt;td&gt;pipeline.rs:1183, 1268–1293&lt;/td&gt;&lt;td&gt;dde7188&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Buffer-callback wake&lt;/td&gt;&lt;td&gt;once per delivered buffer with data&lt;/td&gt;&lt;td&gt;intake.rs:117–136&lt;/td&gt;&lt;td&gt;dde7188&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Supervisor park&lt;/td&gt;&lt;td&gt;≤ 50 ms, or next flush&lt;/td&gt;&lt;td&gt;pipeline.rs:932–936&lt;/td&gt;&lt;td&gt;e59425f&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Output idle flush&lt;/td&gt;&lt;td&gt;100 ms&lt;/td&gt;&lt;td&gt;pipeline.rs:1185&lt;/td&gt;&lt;td&gt;f0b51f4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Output busy flush&lt;/td&gt;&lt;td&gt;1 s, clock read every 64 events&lt;/td&gt;&lt;td&gt;pipeline.rs:1188, 1190&lt;/td&gt;&lt;td&gt;f0b51f4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Stats / ETW QUERY&lt;/td&gt;&lt;td&gt;60 s (0–86,400)&lt;/td&gt;&lt;td&gt;pipeline.rs:92&lt;/td&gt;&lt;td&gt;f0b51f4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DNS PID check&lt;/td&gt;&lt;td&gt;5 s&lt;/td&gt;&lt;td&gt;pipeline.rs:792&lt;/td&gt;&lt;td&gt;f0b51f4&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1170" y="600" width="600" height="380" as="geometry"/></mxCell><mxCell id="timers-c250" value="&lt;b&gt;Measured wait lengths&lt;/b&gt;&lt;br&gt;2 ms asked → median 15.957 ms &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(Q1K)&lt;/font&gt;&lt;br&gt;20 ms asked → 26.7 ms (P0c) &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PPW)&lt;/font&gt;&lt;br&gt;mean park 9.2–11.6 ms under load &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PPW)&lt;/font&gt;&lt;br&gt;timeBeginPeriod(1): mean park 9.7 ms, loss not reduced (P3r) &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PPW)&lt;/font&gt;&lt;br&gt;simulated time to start draining: timed park ≈16 ms · high-resolution waitable timer ≈10 ms · buffer wake ≈0.04 ms &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(BWV)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1170" y="1000" width="600" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="filters" name="8 Filter layers"><mxGraphModel dx="1800" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="filters-c1" value="Where an event is discarded, and which counter records it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18324b;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="38" as="geometry"/></mxCell><mxCell id="filters-c2" value="Top to bottom in the order an event meets each stage. Red rows are loss." style="text;html=