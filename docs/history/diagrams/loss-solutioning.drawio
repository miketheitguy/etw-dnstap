 y="660" width="200" height="60" as="geometry"/></mxCell><mxCell id="pooled-intake-c26" value="&lt;b&gt;receiver_disconnected&lt;/b&gt;&lt;br&gt;try_send Disconnected" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="910" y="660" width="200" height="60" as="geometry"/></mxCell><mxCell id="pooled-intake-c27" value="&lt;b&gt;callback_errors&lt;/b&gt;&lt;br&gt;bad TLS / malformed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1130" y="660" width="200" height="60" as="geometry"/></mxCell><mxCell id="pooled-intake-c28" value="intake_dropped = ring_dropped + pool_exhausted + receiver_disconnected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6b1f1c;" vertex="1" parent="1"><mxGeometry x="470" y="725" width="860" height="26" as="geometry"/></mxCell><mxCell id="pooled-intake-e29" value="Arc&amp;lt;PoolManager&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pooled-intake-c7" target="pooled-intake-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pooled-intake-e30" value="TLS context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="pooled-intake-c8" target="pooled-intake-c9"><mxGeometry relative="1" 