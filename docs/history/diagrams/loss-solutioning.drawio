etry x="1125" y="260" width="34" height="34" as="geometry"/></mxCell><mxCell id="ring-v0-c21" value="…1,024" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=9;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1163" y="260" width="34" height="34" as="geometry"/></mxCell><mxCell id="ring-v0-c22" value="&lt;b&gt;ring_dropped&lt;/b&gt;&lt;br&gt;newest event discarded" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="340" height="70" as="geometry"/></mxCell><mxCell id="ring-v0-c23" value="&lt;b&gt;Empty ring → park_timeout(2 ms)&lt;/b&gt;&lt;br&gt;observed wait median 15.957 ms (WrAlertByThreadId) &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(Q1K)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1270" y="150" width="480" height="80" as="geometry"/></mxCell><mxCell id="ring-v0-c24" value="&lt;b&gt;Parse per event&lt;/b&gt;&lt;br&gt;5 properties × (TdhGetPropertySize + TdhGetProperty)&lt;br&gt;fresh Vec per property; UTF-16 address → String" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1270" y="280" width="480" height="100" as="geometry"/></mxCell><mxCell id="ring-v0-c25" value="&lt;b&gt;Encode&lt;/b&gt;&lt;br&gt;Prost message → encode_to_vec() → write frame" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1270" y="430" width="480" height="70" as="geometry"/></mxCell><mxCell id="ring-v0-e26" value="burst of events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ring-v0-c7" target="ring-v0-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-v0-e27" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ring-v0-c8" target="ring-v0-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-v0-e28" value="ring full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0504d;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ring-v0-c8" target="ring-v0-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-v0-e29" value="pop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ring-v0-c9" target="ring-v0-c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-v0-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ring-v0-c24" target="ring-v0-c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-v0-e31" value="poll after park" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c6902d;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=open;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="ring-v0-c23" target="ring-v0-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-v0-c32" value="&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;th&gt;Run&lt;/th&gt;&lt;th&gt;QPS&lt;/th&gt;&lt;th&gt;Received&lt;/th&gt;&lt;th&gt;Ring drops&lt;/th&gt;&lt;th&gt;EventsLost&lt;/th&gt;&lt;th&gt;Loss&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;auth-1 unpaced (2 vCPU)&lt;/td&gt;&lt;td&gt;179,842&lt;/td&gt;&lt;td&gt;102,723,800&lt;/td&gt;&lt;td&gt;91,309,674&lt;/td&gt;&lt;td&gt;5,181,600&lt;/td&gt;&lt;td&gt;89.42% shortfall (PR28)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rec-2 unpaced&lt;/td&gt;&lt;td&gt;171,495&lt;/td&gt;&lt;td&gt;101,271,058&lt;/td&gt;&lt;td&gt;90,606,333&lt;/td&gt;&lt;td&gt;4,620,024&lt;/td&gt;&lt;td&gt;89.93% (PR28)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;auth-1000qps-1&lt;/td&gt;&lt;td&gt;999.69&lt;/td&gt;&lt;td&gt;599,814&lt;/td&gt;&lt;td&gt;148,638&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;24.78% (Q1K)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rec-1000qps-1&lt;/td&gt;&lt;td&gt;999.69&lt;/td&gt;&lt;td&gt;916,490&lt;/td&gt;&lt;td&gt;341,569&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;37.27% (Q1K)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="900" height="170" as="geometry"/></mxCell><mxCell id="ring-v0-c33" value="&lt;b&gt;Failure: the parser was idle, not overloaded&lt;/b&gt;&lt;br&gt;High water = 1,024 in every run. At 1,000 QPS service CPU was 0.431% of one core and the parser did 1.228 s of parse/encode work in 300 s. &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(Q1K)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="960" y="610" width="810" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ring-fixes" name="4 Ring fixes and capacity"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ring-fixes-c1" value="Ring fixes: wake per enqueue (rejected) vs capacity (accepted), and later capacity tests" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18324b;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="38" as="geometry"/></mxCell><mxCell id="ring-fixes-c2" value="Oct 29 campaign ring-fix-20261029 (RFP, RFV, RWK) and Oct 31 capacity levers (PPW)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526779;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="26" as="geometry"/></mxCell><mxCell id="ring-fixes-c3" value="wake v1 — rejected (RWK)" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#fdf3f2;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="420" height="560" as="geometry"/></mxCell><mxCell id="ring-fixes-c4" value="capacity-only v2 — accepted (RFV)" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#f0f7f2;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="420" height="560" as="geometry"/></mxCell><mxCell id="ring-fixes-c5" value="&lt;b&gt;Callback&lt;/b&gt;&lt;br&gt;try push → on success parser.unpark()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="360" height="70" as="geometry"/></mxCell><mxCell id="ring-fixes-c6" value="&lt;b&gt;Ring 1,024&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="170" height="60" as="geometry"/></mxCell><mxCell id="ring-fixes-c7" value="&lt;b&gt;Parser&lt;/b&gt;&lt;br&gt;2 ms park unchanged" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="170" height="60" as="geometry"/></mxCell><mxCell id="ring-fixes-c8" value="&lt;b&gt;30 s auth @1k QPS&lt;/b&gt;&lt;br&gt;24,342 of 59,938 dropped · HWM 1,024&lt;br&gt;no ETW loss explained it" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="360" height="100" as="geometry"/></mxCell><mxCell id="ring-fixes-e9" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ring-fixes-c5" target="ring-fixes-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-fixes-e10" value="unpark per event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c6902d;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=open;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ring-fixes-c5" target="ring-fixes-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-fixes-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ring-fixes-c6" target="ring-fixes-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-fixes-c12" value="&lt;b&gt;Callback&lt;/b&gt;&lt;br&gt;unchanged" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="360" height="70" as="geometry"/></mxCell><mxCell id="ring-fixes-c13" value="&lt;b&gt;Ring 8,192&lt;/b&gt;&lt;br&gt;(default from here on)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="170" height="60" as="geometry"/></mxCell><mxCell id="ring-fixes-c14" value="&lt;b&gt;Parser&lt;/b&gt;&lt;br&gt;2 ms park unchanged · waits still ≈16 ms" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="690" y="290" width="170" height="60" as="geometry"/></mxCell><mxCell id="ring-fixes-c15" value="&lt;b&gt;300 s @1k QPS&lt;/b&gt;&lt;br&gt;auth 599,278 recv · 0 drops · HWM 3,618&lt;br&gt;rec 905,486 recv · 0 drops · HWM 4,984" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="360" height="100" as="geometry"/></mxCell><mxCell id="ring-fixes-e16" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ring-fixes-c12" target="ring-fixes-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-fixes-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ring-fixes-c13" target="ring-fixes-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ring-fixes-c18" value="&lt;b&gt;30 s matched arms at ≈1,000 QPS &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(RFV)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;th&gt;Arm&lt;/th&gt;&lt;th&gt;Received&lt;/th&gt;&lt;th&gt;Encoded&lt;/th&gt;&lt;th&gt;Ring drops&lt;/th&gt;&lt;th&gt;High water&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Auth, original / 1,024&lt;/td&gt;&lt;td&gt;59,914&lt;/td&gt;&lt;td&gt;36,264&lt;/td&gt;&lt;td&gt;23,650&lt;/td&gt;&lt;td&gt;1,024&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Auth, original / 8,192&lt;/td&gt;&lt;td&gt;59,980&lt;/td&gt;&lt;td&gt;59,980&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;3,022&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Auth, wake v1 / 1,024&lt;/td&gt;&lt;td&gt;59,938&lt;/td&gt;&lt;td&gt;35,596&lt;/td&gt;&lt;td&gt;24,342&lt;/td&gt;&lt;td&gt;1,024&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rec, original / 1,024&lt;/td&gt;&lt;td&gt;90,040&lt;/td&gt;&lt;td&gt;42,393&lt;/td&gt;&lt;td&gt;47,647&lt;/td&gt;&lt;td&gt;1,024&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rec, original / 8,192&lt;/td&gt;&lt;td&gt;90,080&lt;/td&gt;&lt;td&gt;90,080&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;4,972&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rec, wake v1 / 1,024&lt;/td&gt;&lt;td&gt;90,230&lt;/td&gt;&lt;td&gt;45,289&lt;/td&gt;&lt;td&gt;44,941&lt;/td&gt;&lt;td&gt;1,024&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="460" height="260" as="geometry"/></mxCell><mxCell id="ring-fixes-c19" value="&lt;b&gt;Later capacity experiments (6 vCPU unless stated, uncapped load) &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PPW)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;th&gt;Capacity&lt;/th&gt;&lt;th&gt;Result&lt;/th&gt;&lt;th&gt;Note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;16,384 (P0 D2, 4 vCPU)&lt;/td&gt;&lt;td&gt;dropped 6.89M vs 10.46M at 8,192&lt;/td&gt;&lt;td&gt;mostly lower offered load, not faster draining&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;32,768 (P3s)&lt;/td&gt;&lt;td&gt;8.70% / 8.90% vs 29.32% at 8,192&lt;/td&gt;&lt;td&gt;private 94.7 MB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;65,536 (P3r X3)&lt;/td&gt;&lt;td&gt;4.85% vs 35.3%&lt;/td&gt;&lt;td&gt;+147 MB, peak queue 46,533&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;65,536 + above-normal + 1 ms timer (X4)&lt;/td&gt;&lt;td&gt;0.00%&lt;/td&gt;&lt;td&gt;178.6 MB&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="920" y="390" width="850" height="220" as="geometry"/></mxCell><mxCell id="ring-fixes-c20" value="Capacity bought time but cost memory and still failed at higher rates. Waking stayed timer-driven (≈16 ms) until S14 replaced per-event wakes with one wake per delivered ETW buffer." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="370" height="120" as="geometry"/></mxCell><mxCell id="ring-fixes-c21" value="8,192 kept as the default: about 4 s of inflow at 1,000 QPS &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(RB)&lt;/font&gt;. Range 1,024–262,144 (--capacity)." style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="860" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pooled-intake" name="5 Pooled intake"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pooled-intake-c1" value="Pooled ETW intake: preallocated slots, non-blocking admission, lease recycling" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18324b;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="38" as="geometry"/></mxCell><mxCell id="pooled-intake-c2" value="src/etw/pool.rs, src/etw/intake.rs, src/pipeline.rs · design: docs/design/pooled-intake.md" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526779;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="26" as="geometry"/></mxCell><mxCell id="pooled-intake-c3" value="Startup (supervisor)" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="400" height="520" as="geometry"/></mxCell><mxCell id="pooled-intake-c4" value="etw-consumer thread (ProcessTrace)" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="420" height="520" as="geometry"/></mxCell><mxCell id="pooled-intake-c5" value="Channel" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="890" y="100" width="420" height="520" as="geometry"/></mxCell><mxCell id="pooled-intake-c6" value="dnstap-parser thread" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1330" y="100" width="440" height="520" as="geometry"/></mxCell><mxCell id="pooled-intake-c7" value="&lt;b&gt;PoolManager::new(capacity, jumbo) pool.rs:41&lt;/b&gt;&lt;br&gt;regular: ArrayQueue&amp;lt;Box&amp;lt;Slot&amp;gt;&amp;gt; with capacity + 2 slots × 2,048 B&lt;br&gt;jumbo: 64 slots × 131,184 B (--jumbo-capacity 0–256)&lt;br&gt;every page touched before capture" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="360" height="130" as="geometry"/></mxCell><mxCell id="pooled-intake-c8" value="&lt;b&gt;install_producer intake.rs:89&lt;/b&gt;&lt;br&gt;TLS: Sender, pool Arc, context address, parser Thread, enqueued flag" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="360" height="90" as="geometry"/></mxCell><mxCell id="pooled-intake-c9" value="&lt;b&gt;native_etw_callback intake.rs:146&lt;/b&gt;&lt;br&gt;1 provider + ID 256/257 check · 2 PID check&lt;br&gt;3 received++ · 4 copy_record()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="470" y="160" width=