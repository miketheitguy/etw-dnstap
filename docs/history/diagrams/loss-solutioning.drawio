t="40" as="geometry"/></mxCell><mxCell id="filters-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8395a3;strokeWidth=1.5;fontSize=11;fontColor=#18324b;endArrow=open;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="filters-c6" target="filters-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="filters-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="filters-c3" target="filters-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="filters-c10" value="&lt;b&gt;3. No free ETW buffer at MaximumBuffers&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="322.0" y="254" width="716" height="52" as="geometry"/></mxCell><mxCell id="filters-c11" value="EventsLost → etw_lost" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1100" y="260" width="330" height="40" as="geometry"/></mxCell><mxCell id="filters-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8395a3;strokeWidth=1.5;fontSize=11;fontColor=#18324b;endArrow=open;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="filters-c10" target="filters-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="filters-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="filters-c6" target="filters-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="filters-c14" value="&lt;b&gt;4. Buffer not deliverable to the real-time consumer&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="333.0" y="326" width="694" height="52" as="geometry"/></mxCell><mxCell id="filters-c15" value="RealTimeBuffersLost → etw_buffers_lost" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1100" y="332" width="330" height="40" as="geometry"/></mxCell><mxCell id="filters-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8395a3;strokeWidth=1.5;fontSize=11;fontColor=#18324b;endArrow=open;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="filters-c14" target="filters-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="filters-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="filters-c10" target="filters-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="filters-c18" value="&lt;b&gt;5. Callback: provider/ID check, PID check&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1">