<mxfile host="drawio" agent="Claude" version="24.7.17" type="device"><diagram id="timeline" name="1 Timeline"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="timeline-c1" value="etw-dnstap | Event-loss solutioning timeline (Oct 28 – Nov 1, 2026)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18324b;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="38" as="geometry"/></mxCell><mxCell id="timeline-c2" value="Each card: hypothesis → change → measured result. Numbers from docs/history; tags name the source file (PR28 performance-review-2026-10-28 · Q1K performance-1000qps-review · RFV ring-buffer-fix-validation · PVR pooled-vm-performance-review · PRR parser-ramp-review · 4CPU singlepass-four-core-test-results · SRW/SLW WPR results · LLV live-load-validation-plan · KWN etw-keyword-narrowing-plan · PPW parallel-parser-workers-plan · CFG configuration.md · TDH tdh-fallback-removal-plan · BWV buffer-wake-validation)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526779;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="26" as="geometry"/></mxCell><mxCell id="timeline-c3" value="Oct 28 PDT (Oct 29 UTC)" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="340" height="860" as="geometry"/></mxCell><mxCell id="timeline-c4" value="Oct 29" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="340" height="860" as="geometry"/></mxCell><mxCell id="timeline-c5" value="Oct 30" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="730" y="110" width="340" height="860" as="geometry"/></mxCell><mxCell id="timeline-c6" value="Oct 31" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="340" height="860" as="geometry"/></mxCell><mxCell id="timeline-c7" value="Nov 1" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1430" y="110" width="340" height="860" as="geometry"/></mxCell><mxCell id="timeline-l8" value="time →" style="html=1;strokeColor=#526f86;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#18324b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="100" as="sourcePoint"/><mxPoint x="1770" y="100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="timeline-c9" value="&lt;b&gt;S1 Unpaced overload, ring 1,024&lt;/b&gt;&lt;br&gt;179,842 QPS sent, 2 vCPU&lt;br&gt;ring drops 91,309,674 · ETW EventsLost 5,181,600&lt;br&gt;shortfall 89.42% &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PR28)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: find a zero-loss rate&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c10" value="&lt;b&gt;S2 Paced 1,000 QPS&lt;/b&gt;&lt;br&gt;auth 24.78% · rec 37.27% lost at ring&lt;br&gt;EventsLost 0 · parser wait median 15.957 ms vs 2 ms asked &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(Q1K)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: loss at ring, parser idle&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="370" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c11" value="&lt;b&gt;S3 Ring fix&lt;/b&gt;&lt;br&gt;wake-per-enqueue @1,024: 24,342 / 59,938 dropped → rejected&lt;br&gt;capacity 8,192: 0 drops, HWM 3,618 / 4,984 (300 s) &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(RFV)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: ≈1 GiB worst-case copies&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c12" value="&lt;b&gt;S4 Pooled intake (08254d4, 2c62a9f)&lt;/b&gt;&lt;br&gt;preallocated 2 KiB slots, try_send, no callback alloc&lt;br&gt;0 loss to auth 47.3k / rec 27.8k QPS; 64k: 18.78% &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PVR)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: cut per-event work&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="370" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c13" value="&lt;b&gt;S5 Client events only + scratch reuse (3d401cc)&lt;/b&gt;&lt;br&gt;IDs 256/257 only; reusable packet Vec&lt;br&gt;ramp count-aligned to 48k; CPU not measured &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PRR)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: remove TDH per event&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c14" value="&lt;b&gt;S6 Direct encoding → single-pass decoder&lt;/b&gt;&lt;br&gt;cache hit: 0 TDH calls, 1 packet copy&lt;br&gt;100k test: 94,639 QPS, 0.43% short (stage unknown) &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(4CPU)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: where is time spent?&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="750" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c15" value="&lt;b&gt;S7 WPR profiles&lt;/b&gt;&lt;br&gt;parser Wait 26.8 s of 58 s in park_timeout&lt;br&gt;parser CPU 15.74% of a core; single lookup −3.79% &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(SRW, SLW)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: parser waits in park (→S10); test ETW limits (→S8)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#8395a3;fontColor=#394c59;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="750" y="370" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c16" value="&lt;b&gt;S8 Buffer ceiling (L5, ≈160k QPS)&lt;/b&gt;&lt;br&gt;16 buffers: EventsLost 14.8M · 256: 0.67M&lt;br&gt;ring drops rise to 11.4M: loss moves to ring &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(LLV)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: drain rate ≈120–150k/s (→S10)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="750" y="580" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c17" value="&lt;b&gt;S9 Keyword narrowing&lt;/b&gt;&lt;br&gt;MatchAnyKeyword 0x3 + IGNORE_KEYWORD_0&lt;br&gt;parity at ≈30k QPS; no visible DNS CPU change &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(KWN)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: side step; workload already emitted only 256/257&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1100" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c18" value="&lt;b&gt;S10 Scheduling diagnosis P0→P3s&lt;/b&gt;&lt;br&gt;parser parked 48–55%, mean park 9–12 ms&lt;br&gt;65,536 slots 4.85% · priority 15.7% · both+timer 0% &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PPW)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: waiting, not CPU&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#8395a3;fontColor=#394c59;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1100" y="370" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c19" value="&lt;b&gt;S11 Flush control + low-rate defaults (e59425f)&lt;/b&gt;&lt;br&gt;flush off: 1 batch/s, 59–79% lost at 10–20k&lt;br&gt;flush 50 ms @20k: 0 drops; defaults 16 KiB × 12, 1 s &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(CFG)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: wake after flush&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1100" y="580" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c20" value="&lt;b&gt;S12 Supervisor wake after flush (f0b51f4)&lt;/b&gt;&lt;br&gt;idle flush 100 ms · 1 MiB SO_SNDBUF · 128 B dep table&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: simplify decoder&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1450" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c21" value="&lt;b&gt;S13 TDH fallback removed (69db97d)&lt;/b&gt;&lt;br&gt;140 ns/event, CPU within noise&lt;br&gt;still 17–19% ring_dropped at 5k QPS &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(TDH)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#526779&quot;&gt;why next: parser drains too late&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1450" y="370" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-c22" value="&lt;b&gt;S14 Wake once per ETW buffer (dde7188)&lt;/b&gt;&lt;br&gt;5k QPS: 19.6% → 0 · 10k: 60.7% → 0.3–1.1%&lt;br&gt;50k: 0 ring loss; ETW lost 0.03–0.16% &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(BWV)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1450" y="580" width="300" height="160" as="geometry"/></mxCell><mxCell id="timeline-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c9" target="timeline-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c10" target="timeline-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c11" target="timeline-c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c12" target="timeline-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c13" target="timeline-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c14" target="timeline-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c15" target="timeline-c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c15" target="timeline-c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c16" target="timeline-c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c18" target="timeline-c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c19" target="timeline-c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c20" target="timeline-c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="timeline-c21" target="timeline-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="timeline-c36" value="Open after dde7188: 10k QPS defaults 0.3–1.1% ring loss; 50k QPS ETW-internal loss 0.03–0.16% → use --etw-flush-ms 50 --etw-max-buffers 256 --etw-buffer-kib 64 &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(BWV, CFG)&lt;/font&gt;. Parallel workers deferred &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PPW)&lt;/font&gt;." style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1450" y="760" width="300" height="130" as="geometry"/></mxCell><mxCell id="timeline-c37" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;red = loss measured · green = fix accepted · blue = code change · grey = diagnosis · amber = timer change · dashed = side step" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="300" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="etw-buffers" name="2 ETW session buffers"><mxGraphModel dx="1800" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="etw-buffers-c1" value="ETW real-time session: buffers, flush, delivery and loss counters" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18324b;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="38" as="geometry"/></mxCell><mxCell id="etw-buffers-c2" value="Session &quot;EtwDnstap&quot;, EVENT_TRACE_REAL_TIME_MODE. Defaults since e59425f: 16 KiB buffers, MaximumBuffers 12, FlushTimer 1 s, --etw-flush-ms 0." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526779;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="26" as="geometry"/></mxCell><mxCell id="etw-buffers-c3" value="DNS Server process (dns.exe) — user mode" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#f4f6f8;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="300" height="930" as="geometry"/></mxCell><mxCell id="etw-buffers-c4" value="Kernel — ETW session EtwDnstap" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#f4f6f8;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="760" height="930" as="geometry"/></mxCell><mxCell id="etw-buffers-c5" value="etw-dnstap — thread etw-consumer" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="320" height="930" as="geometry"/></mxCell><mxCell id="etw-buffers-c6" value="etw-dnstap — supervisor thread" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1470" y="100" width="300" height="930" as="geometry"/></mxCell><mxCell id="etw-buffers-c7" value="&lt;b&gt;Microsoft-Windows-DNSServer provider&lt;/b&gt;&lt;br&gt;GUID EB79061A-A566-4698-9119-3ED2807060E7&lt;br&gt;EventWrite per DNS packet: 256 query received, 257 response sent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#8395a3;fontColor=#394c59;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="260" height="120" as="geometry"/></mxCell><mxCell id="etw-buffers-c8" value="&lt;b&gt;Pre-generation filter (provider side)&lt;/b&gt;&lt;br&gt;level ≤ 4 · MatchAnyKeyword 0x3 · MatchAllKeyword 0&lt;br&gt;EVENT_ENABLE_PROPERTY_IGNORE_KEYWORD_0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfa;strokeColor=#8974b4;fontColor=#392d5b;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="320" height="90" as="geometry"/></mxCell><mxCell id="etw-buffers-c9" value="&lt;b&gt;Post-generation filters&lt;/b&gt;&lt;br&gt;EVENT_FILTER_TYPE_EVENT_ID {256, 257}&lt;br&gt;EVENT_FILTER_TYPE_PID = DNS service PID" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfa;strokeColor=#8974b4;fontColor=#392d5b;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="330" height="90" as="geometry"/></mxCell><mxCell id="etw-buffers-c10" value="&lt;b&gt;Per-CPU current buffers&lt;/b&gt;&lt;br&gt;events are written to the buffer of the CPU that runs EventWrite" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfa;strokeColor=#8974b4;fontColor=#392d5b;fontSize=12;fontStyle=0;align=center;verticalAlign=top;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="280" width="680" height="150" as="geometry"/></mxCell><mxCell id="etw-buffers-c11" value="CPU0&lt;br&gt;16 KiB · ≈46 events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="390" y="350" width="100" height="56" as="geometry"/></mxCell><mxCell id="etw-buffers-c12" value="CPU1&lt;br&gt;16 KiB · ≈46 events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="100" height="56" as="geometry"/></mxCell><mxCell id="etw-buffers-c13" value="CPU2&lt;br&gt;16 KiB · ≈46 events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="610" y="350" width="100" height="56" as="geometry"/></mxCell><mxCell id="etw-buffers-c14" value="CPU3&lt;br&gt;16 KiB · ≈46 events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="100" height="56" as="geometry"/></mxCell><mxCell id="etw-buffers-c15" value="CPU4&lt;br&gt;16 KiB · ≈46 events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="350" width="100" height="56" as="geometry"/></mxCell><mxCell id="etw-buffers-c16" value="CPU5&lt;br&gt;16 KiB · ≈46 events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="350" width="100" height="56" as="geometry"/></mxCell><mxCell id="etw-buffers-c17" value="&lt;b&gt;Free buffer list&lt;/b&gt;&lt;br&gt;MinimumBuffers requested 4 → ETW raises to ≥ 2 per logical CPU (12 on 6 vCPU)&lt;br&gt;MaximumBuffers 12 (≥ adjusted minimum); allocates more on demand up to the max" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfa;strokeColor=#8974b4;fontColor=#392d5b;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="320" height="130" as="geometry"/></mxCell><mxCell id="etw-buffers-c18" value="&lt;b&gt;Flushed buffers awaiting real-time delivery&lt;/b&gt;&lt;br&gt;a buffer is flushed when full, when FlushTimer (1 s) expires, or on EVENT_TRACE_CONTROL_FLUSH" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfa;strokeColor=#8974b4;fontColor=#392d5b;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="330" height="130" as="geometry"/></mxCell><mxCell id="etw-buffers-c19" value="&lt;b&gt;EventsLost ++&lt;/b&gt;&lt;br&gt;no free buffer and the pool is at MaximumBuffers → the event is discarded at write time &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(MSL)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="660" width="320" height="80" as="geometry"/></mxCell><mxCell id="etw-buffers-c20" value="&lt;b&gt;RealTimeBuffersLost ++&lt;/b&gt;&lt;br&gt;a buffer that could not be delivered to the real-time consumer &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(MSL)&lt;/font&gt;&lt;br&gt;0 in every recorded run &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PR28, LLV, PVR)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="330" height="80" as="geometry"/></mxCell><mxCell id="etw-buffers-c21" value="Observed: at 5,000 QPS ≈10,000 events (≈217 buffers of 16 KiB) arrive per 1 s flush, more than 12 × 16 KiB can hold. How ETW holds them between flushes is not described in the repo docs; treat it as an opaque kernel-managed backlog. &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(BWV, RB)&lt;/font&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="795" width="330" height="100" as="geometry"/></mxCell><mxCell id="etw-buffers-c22" value="L5, ≈160k QPS, 4 vCPU: 64 KiB × 16 → EventsLost 14,810,924; 16 KiB × 16 → 17,317,034; 64 KiB × 256 → 667,666 &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(LLV)&lt;/font&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="795" width="320" height="90" as="geometry"/></mxCell><mxCell id="etw-buffers-c23" value="&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;th&gt;Period&lt;/th&gt;&lt;th&gt;Buffer size × max&lt;/th&gt;&lt;th&gt;FlushTimer / flush-ms&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oct 29 code (08254d4, 3d401cc)&lt;/td&gt;&lt;td&gt;64 KiB × 64 (Min 4)&lt;/td&gt;&lt;td&gt;1 s / none&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oct 30–31 lab tree (L3, L5 defaults)&lt;/td&gt;&lt;td&gt;64 KiB × 256&lt;/td&gt;&lt;td&gt;1 s / 50 ms (earlier default, 9172f2d)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;e59425f … dde7188 (current)&lt;/td&gt;&lt;td&gt;16 KiB × 12&lt;/td&gt;&lt;td&gt;1 s / 0 (off)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Recommended high rate&lt;/td&gt;&lt;td&gt;64 KiB × 256&lt;/td&gt;&lt;td&gt;1 s / 50 ms&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="910" width="540" height="108" as="geometry"/></mxCell><mxCell id="etw-buffers-c24" value="&lt;b&gt;ProcessTrace(consumer)&lt;/b&gt;&lt;br&gt;session.rs:608 · OpenTraceW with PROCESS_TRACE_MODE_REAL_TIME | EVENT_RECORD" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1150" y="300" width="280" height="90" as="geometry"/></mxCell><mxCell id="etw-buffers-c25" value="&lt;b&gt;EventRecordCallback = native_etw_callback&lt;/b&gt;&lt;br&gt;intake.rs:146 · once per event&lt;br&gt;filter → copy_record → try_send; sets enqueued flag" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1150" y="430" width="280" height="90" as="geometry"/></mxCell><mxCell id="etw-buffers-c26" value="&lt;b&gt;BufferCallback = native_buffer_callback&lt;/b&gt;&lt;br&gt;intake.rs:117 · once per delivered buffer&lt;br&gt;etw_buffers_delivered++; if flag: parser.unpark()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1150" y="555" width="280" height="90" as="geometry"/></mxCell><mxCell id="etw-buffers-c27" value="&quot;Events are delivered when the buffers are flushed, not at the time the provider writes the event&quot; (Microsoft Learn, quoted in BWV). Real-time FlushTimer minimum 1 s; 0 means a default of 1 s &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(MSL)&lt;/font&gt;." style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1150" y="800" width="280" height="120" as="geometry"/></mxCell><mxCell id="etw-buffers-c28" value="&lt;b&gt;Optional periodic flush&lt;/b&gt;&lt;br&gt;ControlTraceW(EVENT_TRACE_CONTROL_FLUSH) every --etw-flush-ms&lt;br&gt;0 = off (default) · 20–1000 ms · recommended 50 at high rate (pipeline.rs:897, session.rs:262)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1490" y="150" width="260" height="130" as="geometry"/></mxCell><mxCell id="etw-buffers-c29" value="&lt;b&gt;Statistics query&lt;/b&gt;&lt;br&gt;ControlTraceW(EVENT_TRACE_CONTROL_QUERY) every --stats-interval-seconds (60) and at stop&lt;br&gt;EventsLost → etw_lost · RealTimeBuffersLost → etw_buffers_lost (session.rs:629–640)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1490" y="640" width="260" height="140" as="geometry"/></mxCell><mxCell id="etw-buffers-e30" value="EventWrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="etw-buffers-c7" target="etw-buffers-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etw-buffers-e31" value="if match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="etw-buffers-c8" target="etw-buffers-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etw-buffers-e32" value="admitted events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="etw-buffers-c9" target="etw-buffers-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="etw-buffers-e33" value="buffer swap when full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526f86;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="etw-buffers-c17" target="etw-buffers-c10"><mxGeometry rel