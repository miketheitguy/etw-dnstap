etry"></mxGeometry></mxCell><mxCell id="pooled-intake-e36" value="slot back to free list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f9567;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pooled-intake-c23" target="pooled-intake-c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="600"/><mxPoint x="40" y="600"/><mxPoint x="40" y="225"/></Array></mxGeometry></mxCell><mxCell id="pooled-intake-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0504d;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pooled-intake-c10" target="pooled-intake-c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="340"/><mxPoint x="460" y="640"/><mxPoint x="570" y="640"/></Array></mxGeometry></mxCell><mxCell id="pooled-intake-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0504d;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pooled-intake-c11" target="pooled-intake-c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pooled-intake-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0504d;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pooled-intake-c11" target="pooled-intake-c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pooled-intake-e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0504d;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pooled-intake-c9" target="pooled-intake-c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="232"/><mxPoint x="870" y="560"/><mxPoint x="1230" y="560"/></Array></mxGeometry></mxCell><mxCell id="pooled-intake-c41" value="Defaults 8,192 / 64 → 29,595,984 B (28.22 MiB) counted; max 262,144 / 256 → 711,076,688 B (678.14 MiB). Excludes native ETW buffers, stacks, TDH caches. &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PI)&lt;/font&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="420" height="90" as="geometry"/></mxCell><mxCell id="pooled-intake-c42" value="&lt;b&gt;Ledger identities &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PI)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;received = intake_dropped + callback_errors + dequeued + queue_backlog&lt;br&gt;dequeued = encoded + ignored + rejected + output_failed_events" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="470" y="790" width="420" height="90" as="geometry"/></mxCell><mxCell id="pooled-intake-c43" value="&lt;b&gt;Results (PVR, 2 vCPU)&lt;/b&gt;&lt;br&gt;0 intake loss: auth to 47,303 QPS (300 s), rec to 27,758 QPS (300 s).&lt;br&gt;First loss: auth 56k 0.99%, 64k 18.78%; rec 32k 0.17%. ETW lost 0 in all 22 stages." style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="910" y="790" width="420" height="90" as="geometry"/></mxCell><mxCell id="pooled-intake-c44" value="Pooling removes per-event storage allocation; it is not literal zero-copy. The callback copy is required because ETW's buffer is valid only during the callback. &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PI)&lt;/font&gt;" style="shape=note;size=14;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9dc;strokeColor=#c8ad4f;fontColor=#55491f;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1350" y="790" width="420" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="zero-copy" name="6 Copies and allocations"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="zero-copy-c1" value="Per-event data path: copies, allocations and TDH calls removed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18324b;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="38" as="geometry"/></mxCell><mxCell id="zero-copy-c2" value="Steady state, schema cached, one accepted event. Sink copy into the 64 KiB BufWriter is the same in every column and is not counted. Badges: COPY n (orange) · ALLOC (red) · TDH ×n (purple)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#526779;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="26" as="geometry"/></mxCell><mxCell id="zero-copy-c3" value="Oct 28–29 (08254d4): per-event TDH + owned vectors" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="420" height="800" as="geometry"/></mxCell><mxCell id="zero-copy-c4" value="native_etw_callback → copy_record &lt;font color=&quot;#c6902d&quot;&gt;&lt;b&gt;[COPY 1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;native UserData → pooled slot" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="150" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-c5" value="etw::parse(event) → with_record → parse_record&lt;br&gt;TLS HashMap schema get (cap 32)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="232" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c4" target="zero-copy-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c7" value="property() × 5 (TCP, Port, InterfaceIP, Source/Destination, PacketData)&lt;br&gt;&lt;font color=&quot;#8974b4&quot;&gt;&lt;b&gt;[TDH ×10]&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#c0504d&quot;&gt;&lt;b&gt;[ALLOC ×5]&lt;/b&gt;&lt;/font&gt; vec![0; size] per property&lt;br&gt;&lt;font color=&quot;#c6902d&quot;&gt;&lt;b&gt;[COPY 2]&lt;/b&gt;&lt;/font&gt; packet → Vec" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfa;strokeColor=#8974b4;fontColor=#392d5b;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="314" width="390" height="84" as="geometry"/></mxCell><mxCell id="zero-copy-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c5" target="zero-copy-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c9" value="address() UTF-16 → String::from_utf16 &lt;font color=&quot;#c0504d&quot;&gt;&lt;b&gt;[ALLOC]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="416" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c7" target="zero-copy-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c11" value="RawDnsEvent { packet_data: Vec&amp;lt;u8&amp;gt; } (owned)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="498" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c9" target="zero-copy-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c13" value="encode_event(): identity.to_vec(), octets().to_vec() ×2 &lt;font color=&quot;#c0504d&quot;&gt;&lt;b&gt;[ALLOC ×3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;packet moved into Prost message (no copy)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="580" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c11" target="zero-copy-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c15" value="encode_to_vec() &lt;font color=&quot;#c0504d&quot;&gt;&lt;b&gt;[ALLOC]&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#c6902d&quot;&gt;&lt;b&gt;[COPY 3]&lt;/b&gt;&lt;/font&gt; packet → output Vec" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="662" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c13" target="zero-copy-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c17" value="&lt;b&gt;Per event: 3 packet copies · 10 TDH calls · ≥10 heap allocations (counted from source)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0504d;fontColor=#6b1f1c;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="45" y="810" width="390" height="70" as="geometry"/></mxCell><mxCell id="zero-copy-c18" value="3d401cc (Oct 29): scratch buffers + reusable packet Vec &lt;font color=&quot;#7a8a99&quot; style=&quot;font-size:10px&quot;&gt;(PEO)&lt;/font&gt;" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#eef5fb;swimlaneFillColor=#ffffff;strokeColor=#9aafc1;fontColor=#24415a;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="420" height="800" as="geometry"/></mxCell><mxCell id="zero-copy-c19" value="copy_record &lt;font color=&quot;#c6902d&quot;&gt;&lt;b&gt;[COPY 1]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="485" y="150" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-c20" value="Parser::parse(event, &amp;amp;mut packet)&lt;br&gt;property scratch [u8; 512], text scratch [u8; 768]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="485" y="232" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c19" target="zero-copy-c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c22" value="TdhGetPropertySize + TdhGetProperty × 5 &lt;font color=&quot;#8974b4&quot;&gt;&lt;b&gt;[TDH ×10]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;into scratch; packet into reusable Vec &lt;font color=&quot;#c6902d&quot;&gt;&lt;b&gt;[COPY 2]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfa;strokeColor=#8974b4;fontColor=#392d5b;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="485" y="314" width="390" height="84" as="geometry"/></mxCell><mxCell id="zero-copy-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c20" target="zero-copy-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c24" value="Encoder::encode(…, &amp;amp;mut packet) reuses output + address vectors;&lt;br&gt;packet moved in and reclaimed (mem::take)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="485" y="416" width="390" height="64" as="geometry"/></mxCell><mxCell id="zero-copy-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b84b5;strokeWidth=2;fontSize=11;fontColor=#18324b;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zero-copy-c22" target="zero-copy-c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zero-copy-c2