        </mxCell>
        <mxCell id="tcp" value="&lt;b&gt;Frame Streams TCP exchange&lt;/b&gt;&lt;br&gt;Outbound connection initiated by Windows service&lt;br&gt;READY → ACCEPT → START&lt;br&gt;protobuf:dnstap.Dnstap data frames&lt;br&gt;STOP → FINISH; 2 s deadlines; no reconnect" style="rounded=1;arcSize=12;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
