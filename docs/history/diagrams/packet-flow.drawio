        </mxCell>
        <mxCell id="provider" value="&lt;b&gt;DNS Server ETW provider&lt;/b&gt;&lt;br&gt;GUID EB79061A-A566-4698-9119-3ED2807060E7&lt;br&gt;Events: 256 client query • 257/258 client response&lt;br&gt;260 resolver query • 261 resolver response" style="rounded=1;arcSize=12;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="60" y="295" width="430" height="115" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;Capture and encoding&lt;/b&gt;&lt;br&gt;TDH reads named PacketData + metadata&lt;br&gt;DNS wire bytes preserved; no QNAME reparsing&lt;br&gt;Event time, transport and endpoint roles&lt;br&gt;Ring full drops newest; ETW/callback losses counted&lt;br&gt;Invalid events are rejected and counted" style="rounded=1;arcSize=12;fillColor=#e9f5ed;strokeColor=#4f9567;fontColor=#214c30;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="430" height="115" as="geometry" />
        </mxCell>
        <mxCell id="filter" value="&lt;b&gt;TCP 6000 • plaintext&lt;/b&gt;&lt;br&gt;Guest firewall allows only source&lt;br&gt;172.27.215.163; no TLS/authentication" style="rounded=1;arcSize=12;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
