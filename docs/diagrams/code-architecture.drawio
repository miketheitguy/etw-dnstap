        <mxCell id="s" value="&lt;b&gt;service.rs&lt;/b&gt;&lt;br&gt;SCM status + STOP/SHUTDOWN control&lt;br&gt;Token gate: LocalSystem + enabled service SID&lt;br&gt;Only SeChangeNotifyPrivilege is retained and enabled" style="rounded=1;arcSize=12;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
