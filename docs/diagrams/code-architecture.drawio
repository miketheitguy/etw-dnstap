        <mxCell id="w" value="&lt;b&gt;Lifecycle watchdogs&lt;/b&gt;&lt;br&gt;10 s startup and shutdown deadlines&lt;br&gt;Best-effort Application Event Log on failure" style="rounded=1;arcSize=12;fillColor=#fff3db;strokeColor=#c6902d;fontColor=#644516;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
