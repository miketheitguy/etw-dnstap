        <mxCell id="m" value="&lt;b&gt;main.rs + lib.rs&lt;/b&gt;&lt;br&gt;Parse configuration; enter SCM dispatcher&lt;br&gt;Service-only runtime" style="rounded=1;arcSize=12;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
