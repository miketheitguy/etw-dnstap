        <mxCell id="e" value="&lt;b&gt;etw.rs — real-time ETW&lt;/b&gt;&lt;br&gt;DNS Server provider; ProcessTrace worker&lt;br&gt;Callback copies borrowed bytes into owned events" style="rounded=1;arcSize=12;fillColor=#eaf3fb;strokeColor=#4b84b5;fontColor=#17324d;fontSize=13;spacing=8;html=1;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
